includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    dataset_id = 'cohort-01'
    input_csv = '/path/to/input.csv'
    library = '/path/to/cohort-01_library.tsv'
    // For a predicted library, set library to the .predicted.speclib file
    // and set fasta to its source protein FASTA.
    // fasta = '/path/to/source-proteins.fasta'
    output_dir = '/path/to/output'
    // For fractionated data, use sample_name,fraction_id,path in input_csv
    // and a matching fraction_id column in the EasyPQP library.
    // docker_image_diann_rpackage = 'local-image-tag'
    // Copy acquisitions from remote mounts into the local work directory before DIA-NN.
    // copy_inputs_to_work = true

    // Override DIA-NN flags by their exact command-line names, with '_' for '-'.
    'DIA-NN' {
        qvalue = 0.01
        matrix_qvalue = 0.01
        no_ifs_removal = true
        // no_prot_inf = false
        // mass_acc = 10
    }
}

methods.setup()
