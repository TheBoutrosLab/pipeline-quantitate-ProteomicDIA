includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"
includeConfig "${projectDir}/external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"

methods {
    set_output_and_log_dir = {
        def output_name = manifest.name.replaceFirst('^pipeline-', '')
        params.output_dir_base = "${params.output_dir}/${output_name}-${manifest.version}/${params.dataset_id}"
        def timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", TimeZone.getTimeZone('UTC'))
        params.log_output_dir = "${params.output_dir_base}/log-${manifest.name}-${manifest.version}-${timestamp}"
    }

    set_pipeline_logs = {
        trace.enabled = true
        trace.file = "${params.log_output_dir}/nextflow-log/trace.txt"
        timeline.enabled = true
        timeline.file = "${params.log_output_dir}/nextflow-log/timeline.html"
        report.enabled = true
        report.file = "${params.log_output_dir}/nextflow-log/report.html"
    }

    set_work_dir = {
        if (params.containsKey('work_dir') && params.work_dir) {
            schema.check_path(params.work_dir, 'w')
            workDir = params.work_dir
        } else {
            params.work_dir = System.getenv('NXF_WORK') ?: "${launchDir}/work"
        }
    }

    setup = {
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        if (!(params.dataset_id ==~ /[A-Za-z0-9][A-Za-z0-9._-]*/) || params.dataset_id in ['.', '..']) {
            throw new IllegalArgumentException('dataset_id must be a safe directory name')
        }
        def library = new File(params.library.toString())
        if (!library.isFile() || !library.canRead()) {
            throw new IllegalArgumentException("Library is not a readable file: ${library}")
        }
        def libraryName = library.name.toLowerCase()
        def hasTsv = libraryName.endsWith('.tsv')
        def hasSpeclib = libraryName.endsWith('.speclib')
        def isPredicted = libraryName.endsWith('.predicted.speclib')
        def fastaPath = params.get('fasta')
        if (!hasTsv && !hasSpeclib) {
            throw new IllegalArgumentException('library must be an EasyPQP .tsv or DIA-NN .speclib file')
        }
        if (hasTsv) {
            def libraryLines = library.withReader { reader -> [reader.readLine(), reader.readLine()] }
            if (!libraryLines[1]) {
                throw new IllegalArgumentException("EasyPQP library has no data rows: ${library}")
            }
            def columns = libraryLines[0].split('\\t', -1) as Set
            def required = ['PrecursorMz', 'ProductMz', 'ModifiedPeptideSequence', 'PrecursorCharge',
                            'LibraryIntensity', 'NormalizedRetentionTime', 'ProteinId'] as Set
            if (!columns.containsAll(required)) {
                throw new IllegalArgumentException("EasyPQP library lacks required DIA-NN columns: ${required - columns}")
            }
        } else if (library.length() == 0) {
            throw new IllegalArgumentException('library must be a nonempty .speclib file')
        }
        if (isPredicted && !fastaPath) {
            throw new IllegalArgumentException('A .predicted.speclib library requires fasta')
        }
        if (fastaPath) {
            def fasta = new File(fastaPath.toString())
            if (!fasta.isFile() || !fasta.canRead() || !(fasta.name.toLowerCase() ==~ /.*\.(fa|fasta|faa)/)) {
                throw new IllegalArgumentException('fasta must be a readable .fa, .fasta, or .faa file')
            }
            if (!(fasta.withReader { reader -> reader.readLine()?.startsWith('>') })) {
                throw new IllegalArgumentException('fasta must begin with a FASTA header')
            }
        }
        def legacyKeys = params.keySet().findAll { it.toString().startsWith('diann_') }
        if (legacyKeys) {
            throw new IllegalArgumentException("Move DIA-NN options into params['DIA-NN']: ${legacyKeys}")
        }
        def diann = params['DIA-NN']
        if (!(diann instanceof Map)) {
            throw new IllegalArgumentException("params['DIA-NN'] must be a map of DIA-NN options")
        }
        if (!diann.containsKey('no_prot_inf')) {
            diann.put('no_prot_inf', hasTsv)
        }
        def reserved = ['cfg', 'f', 'dir', 'lib', 'out', 'threads', 'fasta'] as Set
        diann.each { key, value ->
            if (!(key ==~ /[a-z][a-z0-9_]*/) || key in reserved) {
                throw new IllegalArgumentException("Invalid or pipeline-managed DIA-NN option: ${key}")
            }
            def values = value instanceof List ? value : [value]
            values.each { item ->
                if (!(item instanceof Boolean || item instanceof Number || item instanceof CharSequence) ||
                    (item instanceof CharSequence && (!item || item.contains('\n') || item.contains('\r')))) {
                    throw new IllegalArgumentException("Invalid value for DIA-NN option ${key}: ${item}")
                }
            }
        }
        ['matrices', 'smart_profiling', 'no_quant_files', 'peak_center',
         'no_ifs_removal', 'report_lib_info', 'no_prot_inf', 'reannotate'].each { key ->
            if (diann.containsKey(key) && !(diann[key] instanceof Boolean)) {
                throw new IllegalArgumentException("DIA-NN ${key} must be Boolean")
            }
        }
        ['qvalue', 'matrix_qvalue'].each { key ->
            if (!(diann[key] instanceof Number) || diann[key] <= 0 || diann[key] > 1) {
                throw new IllegalArgumentException("DIA-NN ${key} must be a number in (0, 1]")
            }
        }
        if (diann.containsKey('reannotate') && diann['reannotate'] && !fastaPath) {
            throw new IllegalArgumentException("params['DIA-NN'].reannotate requires fasta")
        }
        if (isPredicted && diann['no_prot_inf']) {
            System.err.println('WARNING: DIA-NN --no-prot-inf is set for a predicted library; protein inference will be disabled.')
        }
        if (hasTsv && fastaPath) {
            System.err.println('WARNING: FASTA was supplied with an EasyPQP TSV library; verify that its protein annotations match the library.')
        }
        if (hasTsv && !diann['no_prot_inf']) {
            System.err.println('WARNING: DIA-NN --no-prot-inf is not set for an EasyPQP TSV library; DIA-NN will infer protein groups.')
        }

        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_output_and_log_dir()
        methods.set_pipeline_logs()
        methods.set_work_dir()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params,
            new File("${params.log_output_dir}/nextflow-log/params.json"))
    }
}
