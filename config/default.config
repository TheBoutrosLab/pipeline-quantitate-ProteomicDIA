import nextflow.util.SysHelper

params {
    max_cpus = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()
    min_cpus = 1
    min_memory = 1.MB
    resource_allocation_profile_tag = 'default'

    docker_image_fragpipe = 'fcyucn/fragpipe:24.0'
    docker_image_pyopenms = 'ghcr.io/theboutroslab/pyopenms:3.5.0'
    copy_inputs_to_work = false
    project_script_mount_options = "-v ${projectDir}/src:${projectDir}/src:ro"

    // Keys map directly to DIA-NN flags: no_ifs_removal -> --no-ifs-removal.
    'DIA-NN' {
        qvalue = 0.01
        matrix_qvalue = 0.01
        verbose = 1
        matrices = true
        smart_profiling = true
        no_quant_files = true
        peak_center = true
        no_ifs_removal = true
        report_lib_info = true
    }
}

singularity.enabled = false

profiles {
    standard {
        apptainer.enabled = false
        docker.enabled = true
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
        params.container_mount_flag = '-v'
    }
    docker {
        apptainer.enabled = false
        docker.enabled = true
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
        params.container_mount_flag = '-v'
    }
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        apptainer.autoMounts = true
        apptainer.ociAutoPull = true
        params.container_mount_flag = '-B'
        params.project_script_mount_options = "--bind ${projectDir}/src:${projectDir}/src:ro"
    }
    local {
        docker.enabled = false
        apptainer.enabled = false
        params.project_script_mount_options = ""
    }
}

process {
    cache = true
    debug = true
    executor = 'local'
    cpus = params.max_cpus
    memory = params.max_memory
}
