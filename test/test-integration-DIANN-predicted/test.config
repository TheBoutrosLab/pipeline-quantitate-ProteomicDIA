includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'ECOLI-DIA-predicted'
    input_csv = "${projectDir}/test/test-integration-DIANN-predicted/input.csv"
    library = "${TEST_DATA_DIR}/database/UP000000625_83333-DIANN/predicted-library.predicted.speclib"
    fasta = "${TEST_DATA_DIR}/database/UP000000625_83333.fasta"
    'DIA-NN' {
        no_prot_inf = false
    }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test-integration-DIANN-predicted-input', launchDir
)

methods.setup()
