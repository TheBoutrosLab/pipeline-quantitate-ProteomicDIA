includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    dataset_id = 'ECOLI-DIA'
    input_csv = "${projectDir}/test/test-integration-DIANN/input.csv"
    library = "${TEST_DATA_DIR}/ecoli_dia/generate-ProteomicSpectralLibrary/generate-ProteomicSpectralLibrary-1.0.0/ECOLI-DIA/output/EasyPQP/ECOLI-DIA_library.tsv"
    'DIA-NN' {
        no_prot_inf = true
    }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test-integration-DIANN-input', launchDir
)

methods.setup()
