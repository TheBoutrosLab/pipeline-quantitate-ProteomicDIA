includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
if (!TEST_DATA_DIR) {
    throw new IllegalArgumentException('TEST_DATA_DIR must be set for the Bruker DIA-NN integration case')
}

params {
    dataset_id = 'hela_diapasef'
    copy_inputs_to_work = true
    input_csv = "${projectDir}/test/test-integration-DIANN-bruker/input.csv"
    library = "${TEST_DATA_DIR}/hela_diapasef/output/generate-ProteomicSpectralLibrary/generate-ProteomicSpectralLibrary-1.0.1/hela_diapasef/output/EasyPQP/hela_diapasef_library.tsv"
    'DIA-NN' {
        no_prot_inf = true
    }
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test-integration-DIANN-bruker-input', launchDir
)

methods.setup()
