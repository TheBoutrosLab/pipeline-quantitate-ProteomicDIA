includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')
def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
if (!TEST_DATA_DIR) {
    throw new IllegalArgumentException('TEST_DATA_DIR must be set for the fractionated DIA-NN integration case')
}

params {
    dataset_id = 'ECOLI-DIA'
    input_csv = "${projectDir}/test/test-integration-DIANN-fractionated/input.csv"
    library = "${TEST_DATA_DIR}/ecoli_dia/generate-ProteomicSpectralLibrary-fractionated/generate-ProteomicSpectralLibrary-1.1.0/ECOLI-DIA/output/EasyPQP/ECOLI-DIA_library.tsv"
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(
    params.input_csv, 'test-integration-DIANN-fractionated-input', launchDir
)

methods.setup()

process {
    echo = false
    debug = false
}
